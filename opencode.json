{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/rules/00-core.md",
    ".opencode/rules/00-style.md",
    ".opencode/rules/00-done.md",
    ".opencode/rules/core-first.md",
    ".opencode/rules/file-size.md",
    ".opencode/rules/release-notes.md"
  ],
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "pubspec.yaml",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "pubspec.lock",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "analysis_options.yaml",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/*.g.dart",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "android/**",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "ios/**",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": ".env*",
      "effect": "ask"
    },
    {
      "action": "bash",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "flutter pub add*",
      "effect": "ask"
    },
    {
      "action": "bash",
      "resource": "flutter pub upgrade*",
      "effect": "ask"
    },
    {
      "action": "bash",
      "resource": "git commit*",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "git push*",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "rm *",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    }
  ]
}